; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="the jame gam game jam"
config/description="a game made for the https://itch.io/jam/jame-gam-game-jam"
config/version="0.5.1"
run/main_scene="uid://8plf4h71wl3w"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
boot_splash/bg_color=Color(0.17254902, 0.17254902, 0.16470589, 1)
boot_splash/show_image=false
boot_splash/use_filter=false

[autoload]

ScrollingLayer="*uid://cmd4ntm7fkseu"
Transition="*uid://dqt2q8oytyv6h"
GlobalVariables="*uid://cy8lp4f7c4oct"

[display]

window/size/viewport_width=224
window/size/viewport_height=144
window/size/borderless=true
window/stretch/mode="canvas_items"

[file_customization]


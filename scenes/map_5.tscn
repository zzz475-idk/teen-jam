[sub_resource type="GDScript" id="GDScript_jeisp"]
script/source = "extends TileMapLayer

@onready var player: CharacterBody2D = $player;
@onready var exit: Area2D = $exit;
@onready var hagdnadfsa_player: AudioStreamPlayer2D = $\"hagdnadfsa player\";
var buttons_pressed: int = 0;
var all_buttons_are_pressed: bool = false;

func _physics_process(delta: float) -> void:
	if (buttons_pressed >= 2):
		if (all_buttons_are_pressed == false):
			all_buttons_are_pressed = true;
			player.camera_juice(1.3, 1.3, 1);
			player.can_move = false;
			player.velocity = Vector2(0, 0);
			await(get_tree().create_timer(1).timeout);
			player.can_move = true;
			exit.blocked = false;
			hagdnadfsa_player.play();

func _on_spikes_area_body_entered(body: Node2D) -> void:
	if (body == player):
		player.death();


func _on_exit_body_entered(body: Node2D) -> void:
	if (body == player):
		if (exit.blocked == false):
			Transition.transition(Transition.MAP_6);
			player.can_move = false;


func _on_button_pressed() -> void:
	buttons_pressed += 1;


func _on_button_2_pressed() -> void:
	buttons_pressed += 1;
"


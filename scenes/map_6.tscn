[sub_resource type="TileSet" id="TileSet_g4v7s"]
physics_layer_0/collision_layer = 1
sources/0 = SubResource("TileSetAtlasSource_5kldx")

[sub_resource type="GDScript" id="GDScript_ryx0p"]
script/source = "extends TileMapLayer

@onready var player: CharacterBody2D = $player;
@onready var hagdnadfsa_player: AudioStreamPlayer2D = $\"hagdnadfsa player\";
@onready var exit: Area2D = $exit;
@onready var exit_2: Area2D = $exit2;


func _on_spikes_area_body_entered(body: Node2D) -> void:
	if (body == player):
		player.death();


func _on_exit_body_entered(body: Node2D) -> void:
	if (body == player):
		Transition.transition(Transition.MAP_4);
		player.can_move = false;


func _on_button_pressed() -> void:
	exit.blocked = false;
	exit_2.blocked = false;
	
	player.camera_juice(1.1, 1.1, 1);
	player.can_move = false;
	player.velocity = Vector2(0, 0);
	await(get_tree().create_timer(1).timeout);
	player.can_move = true;
	hagdnadfsa_player.play();
"

